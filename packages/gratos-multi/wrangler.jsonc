{
	"name": "gratos-multi",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gratos-multi-db",
			"database_id": "389751d6-783e-44f4-904e-d4bac628d36e"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "4a69a0c80e604ac19285eec842682190"
		}
	],
	"services": [
		{
			// The authz worker has no public route; this worker mounts it at
			// /authz and /v1/authz/* on every tenant host, forwarding requests
			// with trusted X-Gratos-Tenant / X-Gratos-User headers. The
			// AuthzRPC entrypoint also exposes control-plane writes
			// (grantTenantOwners / cleanupTenant) used by the sandbox hooks.
			"binding": "AUTHZ",
			"service": "gratos-authz",
			"entrypoint": "AuthzRPC"
		}
	],
	"env": {
		"prod": {
			"routes": [
				{
					"pattern": "authgravity.authgravity.org",
					"custom_domain": true
				},
				{
					// Instant sandbox pools live under this single custom domain,
					// with the sandbox id in the path (sandbox.authgravity.org/<id>).
					// custom_domain auto-provisions DNS + a dedicated cert (no ACM,
					// no wildcard needed).
					"pattern": "sandbox.authgravity.org",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gratos-multi-db",
					"database_id": "389751d6-783e-44f4-904e-d4bac628d36e"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "4a69a0c80e604ac19285eec842682190"
				}
			],
			"services": [
				{
					"binding": "AUTHZ",
					"service": "gratos-authz-prod",
					"entrypoint": "AuthzRPC"
				}
			]
		}
	}
}
