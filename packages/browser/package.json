{
    "name": "@authgravity/browser",
    "version": "0.0.7",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "bun build ./src/index.ts --outdir ./dist --external @noble/curves --external @noble/hashes && tsc",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "release": "bun run build && node -e \"const p=require('./package.json');const v=p.version.split('.');v[2]=+v[2]+1;p.version=v.join('.');require('fs').writeFileSync('./package.json',JSON.stringify(p,null,4)+'\\n')\" && bun publish"
    },
    "dependencies": {
        "@noble/curves": "^2.2.0",
        "@noble/hashes": "^2.2.0"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
