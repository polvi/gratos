{
	// Internal-only worker: no routes, no workers.dev. Reachable exclusively via
	// the AUTHZ service binding from gratos-multi, which authenticates requests
	// and forwards them with trusted X-Gratos-Tenant / X-Gratos-User headers.
	"name": "gratos-authz",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// Tenant key of the control-plane authz space (gratos_tenant tuples).
		"ROOT_TENANT": "localhost",
		// Browser Rendering crawl API account for AI schema generation.
		// Pair with a CF_API_TOKEN secret (Browser Rendering permission);
		// without the secret, generation falls back to fetching the homepage.
		"CF_ACCOUNT_ID": "de7a9036d3ef17964cf2ca17735f74ab"
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gratos-authz-db",
			"database_id": "LOCALLY-GENERATED-ID"
		}
	],
	"env": {
		"prod": {
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"ROOT_TENANT": "authgravity.org",
				"CF_ACCOUNT_ID": "de7a9036d3ef17964cf2ca17735f74ab"
			},
			"ai": {
				"binding": "AI"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gratos-authz-db",
					"database_id": "878826ab-1ca7-4d29-ba17-7f76ecc1d920"
				}
			]
		}
	}
}
