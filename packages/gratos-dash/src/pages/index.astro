---
import Layout from "../layouts/Layout.astro";
import { HeroPrompt } from "../components/HeroPrompt";
import { HomeAuth } from "../components/HomeAuth";
import { env } from "cloudflare:workers";

export const prerender = false;

const apiBaseUrl = env.PUBLIC_GRATOS_SERVER || import.meta.env.PUBLIC_GRATOS_SERVER;
---

<Layout title="AuthGravity - Zero Knowledge Identity">
  <style>
    .hero {
      margin: 4rem 0 6rem;
      text-align: left;
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }
    .hero p {
      font-size: 1.15rem;
      color: #52525b;
      line-height: 1.7;
      margin-bottom: 1rem;
    }
  </style>

  <div class="hero">
    <h1>Zero Knowledge Identity</h1>
    <p>
      AuthGravity is a hosted, free and open source, first-party authentication
      service for the post-password era. It provides modern, privacy-focused
      user authentication using passkeys.
    </p>
    <HomeAuth client:only="preact" apiBaseUrl={apiBaseUrl} />
    <HeroPrompt client:load />
  </div>
</Layout>
