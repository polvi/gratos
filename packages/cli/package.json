{
    "name": "@authgravity/cli",
    "version": "0.0.7",
    "type": "module",
    "bin": {
        "authgravity": "bin/authgravity.js"
    },
    "files": [
        "bin",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "bun ./src/cli.ts listen",
        "typecheck": "tsc --noEmit",
        "release": "bun run typecheck && node -e \"const p=require('./package.json');const v=p.version.split('.');v[2]=+v[2]+1;p.version=v.join('.');require('fs').writeFileSync('./package.json',JSON.stringify(p,null,4)+'\\n')\" && bun publish"
    },
    "dependencies": {
        "@authgravity/server": "workspace:*",
        "hono": "^4.11.3"
    },
    "devDependencies": {
        "bun-types": "^1.3.5",
        "typescript": "^5.9.3"
    }
}
